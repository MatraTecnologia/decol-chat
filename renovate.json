{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "minimumReleaseAge": "3 days",
  "lockFileMaintenance": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "Group all non-major updates into a single weekly PR",
      "matchUpdateTypes": ["patch", "minor"],
      "groupName": "non-major dependencies"
    },
    {
      "description": "Keep TypeScript on 6.x — 7.x breaks typescript-eslint + tsc-alias",
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<7"
    },
    {
      "description": "Keep @types/node on 24.x to match the Node 24 runtime",
      "matchPackageNames": ["@types/node"],
      "allowedVersions": "<25"
    }
  ]
}
