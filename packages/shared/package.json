{
  "name": "@workspace/shared",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    "./roles": {
      "types": "./src/roles.ts",
      "default": "./dist/roles.js"
    },
    "./auth-cookie": {
      "types": "./src/auth-cookie.ts",
      "default": "./dist/auth-cookie.js"
    },
    "./permissions": {
      "types": "./src/permissions.ts",
      "default": "./dist/permissions.js"
    },
    "./whatsapp-templates": {
      "types": "./src/whatsapp-templates.ts",
      "default": "./dist/whatsapp-templates.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0"
  },
  "dependencies": {
    "better-auth": "^1.7.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "typescript": "^6.0.3"
  }
}
