# APP
NEXT_PUBLIC_APP_NAME="SaaS Starter"
NEXT_PUBLIC_APP_DESCRIPTION="Full-stack SaaS starter template"
NEXT_PUBLIC_APP_KEYWORDS="saas, nextjs, turborepo"
NEXT_PUBLIC_APP_CREATOR="Your Name/Company"

# COMPANY
NEXT_PUBLIC_COMPANY_NAME="Example Corp"

# ─── DEV (default) ────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:3333"
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
# NEXT_PUBLIC_COOKIE_DOMAIN não é necessário em dev

# ─── PROD (cross-subdomain) ───────────────────────────────────────────────────
# Exemplo Easypanel — substitua "<slug>" pelo slug real do seu projeto:
#
# NEXT_PUBLIC_API_URL="https://<app>-api.<slug>.easypanel.host"
# NEXT_PUBLIC_BASE_URL="https://<app>-dashboard.<slug>.easypanel.host"
# NEXT_PUBLIC_COOKIE_DOMAIN=".<slug>.easypanel.host"
#
# NEXT_PUBLIC_COOKIE_DOMAIN deve começar com "." e bater EXATAMENTE com
# COOKIE_DOMAIN setado na API. É usado por /api/clear-session para invalidar o
# cookie de sessão com o escopo correto no logout.

# Embedded Signup (Coexistence)
NEXT_PUBLIC_META_APP_ID=
NEXT_PUBLIC_META_ES_CONFIG_ID=

# SEO
NEXT_PUBLIC_INDEXABLE="false"

# DEPLOYMENT
APP_NAME="dashboard"
