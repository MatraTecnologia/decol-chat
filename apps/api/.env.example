# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/saas_app?schema=public"

# Better Auth
APP_NAME="SaaS App"
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="your-secret-key-here"

# ─── DEV (default) ────────────────────────────────────────────────────────────
BETTER_AUTH_URL="http://localhost:3333"
SITE_URL="http://localhost:3000"
TRUSTED_ORIGINS="http://localhost:3000,http://localhost:3001"
# COOKIE_DOMAIN não é necessário em dev (mesmo host, portas diferentes = same-site)

# ─── PROD (cross-subdomain) ───────────────────────────────────────────────────
# Exemplo Easypanel — substitua "<slug>" pelo slug real do seu projeto:
#   API:       https://<app>-api.<slug>.easypanel.host
#   DASHBOARD: https://<app>-dashboard.<slug>.easypanel.host
#
# BETTER_AUTH_URL="https://<app>-api.<slug>.easypanel.host"
# SITE_URL="https://<app>-dashboard.<slug>.easypanel.host"
# TRUSTED_ORIGINS="https://<app>-dashboard.<slug>.easypanel.host,https://<app>-api.<slug>.easypanel.host"
# COOKIE_DOMAIN=".<slug>.easypanel.host"
#
# IMPORTANTE: COOKIE_DOMAIN deve começar com "." e ser o domínio pai compartilhado.
# Caveat PSL: se o domínio pai estiver na Public Suffix List, o browser recusa o
# cookie. Após o primeiro login em prod, abra DevTools → Application → Cookies e
# confirme que `__Secure-better-auth.session_token` aparece com Domain=.<slug>...
# Se não, COOKIE_DOMAIN não funcionará nesse domínio (use mesmo origin via proxy
# ou aceite sessão por origem).

# Email (Resend)
RESEND_API_KEY="re_xxxxxxxxxxxx"
EMAIL_FROM="SaaS App <contact@example.com>"

# AI
OPENAI_API_KEY="sk-proj-xxxxxxxxxxxx"

# Cloudflare R2
R2_PUBLIC_URL="https://pub-your-id.r2.dev"
R2_ENDPOINT="https://your-account-id.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_PUBLIC_BUCKET_NAME="saas-public"
R2_PRIVATE_BUCKET_NAME="saas-private"

# Health / Under Pressure (OPTIONAL - default: true)
# UNDER_PRESSURE_ENABLED="true"

# Redis (REQUIRED — enables BullMQ queues + cache helper)
REDIS_URL="redis://localhost:6379"

# Bull Board (OPTIONAL - without this the dashboard is open) /admin/queues
BULL_BOARD_USER="admin"
BULL_BOARD_PASSWORD="change-me"

# WhatsApp Cloud API (OPTIONAL - sem elas a API sobe normalmente)
# Chave de 32 bytes em base64 usada para cifrar accessToken e appSecret da conexão.
# Gere com: openssl rand -base64 32
# Ausente → as rotas de WhatsApp respondem 503 explicando qual env falta.
# WHATSAPP_ENCRYPTION_KEY=""
#
# Base pública HTTPS que a Meta usa para alcançar POST /webhooks/whatsapp.
# Sem valor, cai para BETTER_AUTH_URL — que em dev é localhost e é inalcançável
# pela Meta (use ngrok/cloudflared). O campo de override na página /conexao
# sobrescreve esta env sem exigir restart.
# PUBLIC_WEBHOOK_BASE_URL="https://your-tunnel.ngrok-free.app"

# Embedded Signup (Coexistence) — App Dashboard da Meta
META_APP_ID=
META_APP_SECRET=
META_ES_CONFIG_ID=
# Precisa ser igual ao configurado em Webhooks > Verify Token no App Dashboard
META_WEBHOOK_VERIFY_TOKEN=

# Server (OPTIONAL)
PORT=3333
HOST="0.0.0.0"
NODE_ENV="development"
