{
  "extends": "@workspace/typescript-config/base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": ".",
    "incremental": false,
    // app, não lib: nenhum consumidor dos .d.ts (o build já desliga). Com declaration
    // ligado, o typecheck quebra no TS4023 do @better-auth/i18n 1.7 (tipos internos não exportados)
    "declaration": false,
    "declarationMap": false,
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src", "prisma.config.ts"],
  "exclude": ["node_modules", "dist", "src/generated"]
}
