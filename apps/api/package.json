{
  "name": "@workspace/api",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "cross-env NODE_ENV=development PORT=3333 bun --watch src/index.ts",
    "build": "tsc --project tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start": "cross-env NODE_ENV=production PORT=80 node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "db:generate": "prisma generate && tsx scripts/fix-zod-imports.ts",
    "db:push": "prisma db push",
    "db:reset": "prisma db push --force-reset && prisma generate && tsx scripts/fix-zod-imports.ts",
    "db:studio": "prisma studio",
    "redis:flush": "tsx scripts/redis-flush.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.16",
    "@ai-sdk/openai": "^4.0.16",
    "@aws-sdk/client-s3": "^3.1090.0",
    "@aws-sdk/s3-request-presigner": "^3.1090.0",
    "@better-auth/i18n": "^1.6.23",
    "@better-auth/prisma-adapter": "^1.6.23",
    "@better-auth/redis-storage": "^1.6.23",
    "@bull-board/api": "^8.1.2",
    "@bull-board/fastify": "^8.1.2",
    "@fastify/autoload": "^6.4.0",
    "@fastify/compress": "^9.1.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/etag": "^6.2.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/rate-limit": "^11.1.0",
    "@fastify/sensible": "^6.0.4",
    "@fastify/swagger": "^9.8.1",
    "@fastify/under-pressure": "^9.1.0",
    "@paralleldrive/cuid2": "^3.3.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@scalar/fastify-api-reference": "^1.62.9",
    "@t3-oss/env-core": "^0.13.11",
    "@workspace/shared": "workspace:*",
    "ai": "^7.0.31",
    "axios": "^1.18.1",
    "better-auth": "^1.6.23",
    "bullmq": "^5.80.9",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.10.0",
    "fastify-plugin": "^6.0.0",
    "fastify-type-provider-zod": "^7.0.0",
    "ioredis": "^5.11.1",
    "isomorphic-dompurify": "^3.19.0",
    "marked": "^18.0.6",
    "prisma-zod-generator": "^2.1.4",
    "react-email": "^6.9.0",
    "resend": "^6.17.2",
    "slugify": "^1.6.9",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "pino-pretty": "^13.1.3",
    "prisma": "^7.8.0",
    "react": "^19.2.7",
    "tsc-alias": "^1.9.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3"
  }
}
